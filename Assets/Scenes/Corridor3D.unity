  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoomManager
  rooms:
  - title: Range
    objective: Standing still is accurate. Moving isn't. Hit all 3 targets to unlock the door.
    entryPoint: {fileID: 1848493664}
    introPanel: {fileID: 153265614}
  - title: Weak Point
    objective: Body shots barely scratch them. Go for the eye - the door won't open until all four are down.
    entryPoint: {fileID: 3100000030}
    introPanel: {fileID: 3100000098}
  - title: Holding Angle
    objective: Two drones hold this doorway - peek one angle at a time. The door opens once both are down.
    entryPoint: {fileID: 339743820}
    introPanel: {fileID: 1785429454}
  - title: Recon
    objective: Throw a Recon Dart before you round the corner. The door opens once you've scouted the room.
    entryPoint: {fileID: 3200000029}
    introPanel: {fileID: 3200000105}
  - title: Smoke
    objective: Throw a Smoke Wall to block their view. The door opens once it's up - then go.
    entryPoint: {fileID: 1998657633}
    introPanel: {fileID: 151819807}
  - title: Flash
    objective: Flash to blind them. The door opens once you've used it - then go.
    entryPoint: {fileID: 2124449286}
    introPanel: {fileID: 1387739133}
  - title: Dash
    objective: No cover - Dash across the open lane. The door opens once you've dashed.
    entryPoint: {fileID: 1767623139}
    introPanel: {fileID: 624896661}
  - title: The Round
    objective: Clear both Sentinels, then hold [4] at the charge site to plant - survive the countdown to win.
    entryPoint: {fileID: 1497267426}
    introPanel: {fileID: 0}
  player: {fileID: 1584037075}
  fadeOverlay: {fileID: 1133538344}
  roomTitleLabel: {fileID: 147166729}
  objectiveLabel: {fileID: 722714020}
  followCamera: {fileID: 811350177}
  abilities: {fileID: 1584037076}
  fadeSeconds: 0.35
  holdSeconds: 0.45
  entryGraceSeconds: 1
