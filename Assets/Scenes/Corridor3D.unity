--- !u!114 &1974128804
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1974128798}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c4a06aee43b1e944989be18d1ce66989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AbilityUnlockCardUI
  card: {fileID: 1031067918}
  iconImage: {fileID: 466120230}
  keyText: {fileID: 357788161}
  nameText: {fileID: 130388120}
  descriptionText: {fileID: 1204681082}
  tipText: {fileID: 2049755047}
  dismissHint: {fileID: 1585029054}
  dismissGraceSeconds: 0.6
  hintFadeSeconds: 0.25
  ultimate: {fileID: 1584037081}
  rooms: {fileID: 1416355654}
  roomCards:
  - key: 
    abilityName: THE RANGE
    description: '[WASD] to move, mouse to look, [Left-click] to shoot, [R] to reload. Stand still and your shots land together. Move and they spread.'
    tip: Hit all 3 targets to open the door. Dying restarts the run until you reach the Room 5 checkpoint.
    icon: {fileID: 0}
  - key: 
    abilityName: WEAK POINT
    description: Body shots barely scratch these drones, so aim for the red eye. They can't shoot back.
    tip: Holding fire makes the gun climb, so tap or burst. Kill all 4 to open the door.
    icon: {fileID: 0}
  - key: 
    abilityName: HOLDING ANGLE
    description: Two armed drones hold this end. Each pillar hides you from one of them, so fight them one at a time.
    tip: Hold [Ctrl] to crouch behind cover. [Space] jumps.
    icon: {fileID: 0}
  - key: F
    abilityName: RECON DART
    description: Hold [F] to aim, [Right-click] to add bounces, release to fire. It reveals any drones it can see.
    tip: Running is loud and drones turn toward it. Hold [Alt] to walk silently.
    icon: {fileID: 21300000, guid: 2160dbcff99da674d96411d3ac95c4be, type: 3}
  - key: Q
    abilityName: SMOKE WALL
    description: Drops a wall of smoke that blocks drone sight. You can walk through it, and bullets pass through it both ways.
    tip: Both drones watch the gap in the wall. Smoke it, then go. They still fire at where they last saw you.
    icon: {fileID: 21300000, guid: aa98f8cd7844ac540a3db1599cbd4c6c, type: 3}
  - key: E
    abilityName: FLASH
    description: Blinds every drone within 10m, even round a corner. Flashed drones can't shoot or move, and their eye burns white.
    tip: Get close behind the wall, flash, then peek. When the sparks flicker, the drone is about to recover.
    icon: {fileID: 21300000, guid: a444145e4a2435c49a4e399b2691469e, type: 3}
  - key: SHIFT
    abilityName: DASH
    description: A burst of speed. You can't be hurt while dashing.
    tip: The lane between the crates is watched. Dash across it, cover to cover.
    icon: {fileID: 21300000, guid: f3e905cc784c2bd4f8302eff9c1f33fb, type: 3}
  - key: 
    abilityName: THE ROUND
    description: Kill both drones, then stand at the site and hold [4] to plant. Moving or taking damage cancels the plant.
    tip: Reinforcements come for the charge. Kill or flash any drone that reaches it, and hold until it blows.
    icon: {fileID: 0}
  ultimateCard:
    key: X
    abilityName: OVERWATCH PROTOCOL
    description: Reveals every Sentinel in the level and cuts incoming damage for several seconds.
    tip: Charges from killing armed drones and collecting orbs. Save it to buy the safe window for your push.
    icon: {fileID: 21300000, guid: 53b7749609bbe4744803cb077e2567f2, type: 3}
